class ProxyManager:
    """Rotates proxies and returns a fresh session."""
    def __init__(self, proxy_list: List[str], rotation_interval: int = 60):
        self.proxies = proxy_list
        self.rotation_interval = rotation_interval
        self._last_rotation = 0
        self._current_idx = 0
        self._lock = __import__('threading').Lock()

    def get_proxy(self) -> Optional[Dict[str, str]]:
        if not self.proxies:
            return None
        now = time.time()
        with self._lock:
            if now - self._last_rotation > self.rotation_interval:
                self._current_idx = (self._current_idx + 1) % len(self.proxies)
                self._last_rotation = now
            proxy_url = self.proxies[self._current_idx]
        return {"http": proxy_url, "https": proxy_url}

    def new_session(self, with_proxy: bool = True) -> requests.Session:
        session = requests.Session()
        if with_proxy:
            proxy = self.get_proxy()
            if proxy:
                session.proxies.update(proxy)
        session.headers.update({
            "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
        })
        return session

