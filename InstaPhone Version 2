celery_app = Celery('instaphone', broker=config.CELERY_BROKER_URL, backend=config.CELERY_RESULT_BACKEND)
celery_app.conf.update(task_track_started=True)

@celery_app.task(bind=True)
def run_search_task(self, input_type: str, input_value: str) -> dict:
    """Orchestrates the full search asynchronously."""
    from uuid import uuid4
    task_id = self.request.id
    # Update DB status
    task = db_session.query(SearchTask).filter_by(id=task_id).first()
    if not task:
        task = SearchTask(id=task_id, input_type=input_type, input_value=input_value, status='running')
        db_session.add(task)
    else:
        task.status = 'running'
    db_session.commit()

    try:
        engine = InstaPhoneEngine()
        if input_type == 'username':
            results = engine.search_by_username(input_value)
        else:
            results = engine.search_by_name(input_value)
        # Serialize results
        result_list = [{'phone': p, 'confidence': c, 'metadata': m} for p, c, m in results]
        task.result_json = json.dumps(result_list)
        task.status = 'completed'
        db_session.commit()
        return {'task_id': task_id, 'status': 'completed', 'results': result_list}
    except Exception as e:
        log.exception("Task %s failed", task_id)
        task.status = 'failed'
        task.result_json = json.dumps({'error': str(e)})
        db_session.commit()
        raise

