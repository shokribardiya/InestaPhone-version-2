# UTILITY DECORATORS
# ---------------------------------------------------------------------------
def retry(max_retries=3, delay=2, backoff=2, exceptions=(Exception,)):
    """Retry decorator with exponential backoff."""
    def decorator(func):
        @wraps(func)def wrapper(*args, **kwargs):
            m_retries, m_delay = max_retries, delay
            while m_retries > 1:
                try:
                    return func(*args, **kwargs)
                except exceptions as e:
                    log.warning("Retry %s/%s for %s: %s", max_retries - m_retries + 1, max_retries, func.__name__, e)
                    time.sleep(m_delay)
                    m_retries -= 1
                    m_delay *= backoff
            return func(*args, **kwargs)
        return wrapper
    return decorator

