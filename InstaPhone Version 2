@app.route('/search', methods=['POST'])
def search():
    input_type = request.form.get('type', 'username')
    value = request.form.get('value', '').strip()
    if not value:
        return jsonify({'error': 'Missing input'}), 400
    # Create task
    task = run_search_task.delay(input_type, value)
    return jsonify({'task_id': task.id, 'status': 'submitted'})

@app.route('/status/<task_id>')
def task_status(task_id):
    result = AsyncResult(task_id, app=celery_app)
    if result.state == 'PENDING':
        response = {'state': result.state, 'progress': 'Job not started yet.'}
    elif result.state == 'STARTED':
        response = {'state': result.state, 'progress': 'Processing...'}
    elif result.state == 'SUCCESS':
        response = {'state': 'SUCCESS', 'results': result.result.get('results', [])}
    elif result.state == 'FAILURE':
        response = {'state': 'FAILURE', 'error': str(result.result)}
    else:
        response = {'state': result.state}return jsonify(response)

@app.route('/export/csv/<task_id>')
def export_csv(task_id):
    result = AsyncResult(task_id, app=celery_app)
    if result.state == 'SUCCESS':
        data = result.result.get('results', [])
        df = pd.DataFrame(data)
        csv_path = f"/tmp/instaphone_{task_id}.csv"
        df.to_csv(csv_path, index=False)
        return send_file(csv_path, mimetype='text/csv', as_attachment=True, download_name='results.csv')
    return "Results not ready", 404

