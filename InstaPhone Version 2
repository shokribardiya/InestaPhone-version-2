class IdentityGraph:
    """
    Builds a weighted undirected graph with multiple node types:
      identity, handle, email, phone, full_name, location, domain, etc.
    Edges weighted by source reliability and co‑occurrence frequency.
    Community detection using Louvain algorithm.
    """
    def __init__(self):
        self.graph = nx.Graph()
        self.node_counter = 0

    def _unique_node_id(self, prefix: str, value: str) -> str:
        """Ensure unique node IDs; avoid collisions."""
        return f"{prefix}::{value}"

    def add_entity(self, identity_id: str, attr_type: str, value: str, weight: float = 1.0, source: str = "unknown"):
        """
        Add an identity node (if not exists) and connect it to an attribute node.
        Updates weight cumulatively.
        """
        if not value:
            return
        # Identity node
        if not self.graph.has_node(identity_id):
            self.graph.add_node(identity_id, type='identity')
        # Attribute node
        attr_node = self._unique_node_id(attr_type, value.lower())
        if not self.graph.has_node(attr_node):
            self.graph.add_node(attr_node, type=attr_type, value=value)
        # Edge with weight
        if self.graph.has_edge(identity_id, attr_node):
            self.graph[identity_id][attr_node]['weight'] += weight
            self.graph[identity_id][attr_node]['sources'].add(source)
        else:
            self.graph.add_edge(identity_id, attr_node, weight=weight, sources={source})

    def build_from_profile(self, profile: dict, cross_data: dict, breach_emails: list, breach_names: list, breach_phone: list):
        """Populate graph using all gathered intelligence."""
        norm = NameNormaliser()
        main_id = f"identity_insta_{profile.get('username', '')}"

        # Instagram attributes
        self.add_entity(main_id, 'handle', profile.get('username', ''), 2.0, 'instagram')
        if profile.get('full_name'):
            full = norm.normalise_name(profile['full_name'])
            self.add_entity(main_id, 'full_name', full, 2.0, 'instagram')
            for nick in norm.generate_nicknames(full):
                self.add_entity(main_id, 'full_name', nick, 1.2, 'nickname')
        for email in profile.get('emails_in_bio', []):
            self.add_entity(main_id, 'email', email, 3.0, 'instagram_bio')
        for phone_hint in profile.get('phone_hints_in_bio', []):
            self.add_entity(main_id, 'phone', phone_hint, 2.5, 'instagram_bio')
        for loc in profile.get('location_tags', []):
            self.add_entity(main_id, 'location', loc, 1.0, 'instagram')
        for linked_platform, url in [('facebook', profile.get('linked_facebook')),
                                     ('twitter', profile.get('linked_twitter')),
                                     ('tiktok', profile.get('linked_tiktok')),
                                     ('linkedin', profile.get('linked_linkedin'))]:
            if url:
                self.add_entity(main_id, f'url_{linked_platform}', url, 1.8, 'instagram_link')

        # Cross-platform data
        if cross_data:
            for email in cross_data.get('emails', []):
                self.add_entity(main_id, 'email', email, 2.5, 'cross_platform')
            for phone in cross_data.get('phones', []):
                self.add_entity(main_id, 'phone', phone, 2.5, 'cross_platform')
            for platform, link in cross_data.get('social_links', {}).items():
                self.add_entity(main_id, f'url_{platform}', link, 1.5, 'cross_platform')

        # Breach data (mapping emails → phones, names → phones)
        for phone, name, username, src, ldate in breach_emails:
            self.add_entity(main_id, 'phone', phone, 3.0, f'breach_{src}')
            if name:
                self.add_entity(main_id, 'full_name', norm.normalise_name(name), 2.0, f'breach_{src}')
        for phone, email, username, src, ldate in breach_names:
            self.add_entity(main_id, 'phone', phone, 3.0, f'breach_{src}')
            if email:
                self.add_entity(main_id, 'email', email, 2.0, f'breach_{src}')

    def resolve_target(self, target_id: str, max_candidates: int = 20) -> List[Tuple[str, float, Dict]]:
        """
        Detect community containing target_id, collect phone nodes,
        compute aggregated score = sum(edge weights * source multipliers).
        Returns sorted list of (phone, confidence, metadata).
        """
        if target_id not in self.graph:
            return []

        # Louvain community detection (fast, scalable)
        communities = louvain_communities(self.graph, weight='weight', seed=42)
        target_comm = None
        for comm in communities:
            if target_id in comm:
                target_comm = comm
                break
        if not target_comm:
            return []

        # Phone nodes in same community
        phone_nodes = [n for n in target_comm if self.graph.nodes[n].get('type') == 'phone']
        scores = {}
        for phone_node in phone_nodes:
            total_weight = 0.0
            sources_set = set()
            for neighbor in self.graph.neighbors(phone_node):
                if neighbor in target_comm:
                    edge_data = self.graph.get_edge_data(phone_node, neighbor)
                    total_weight += edge_data.get('weight', 1)
                    sources_set.update(edge_data.get('sources', []))
            scores[phone_node] = (total_weight, sources_set)

        # Sort by total weight
        sorted_phones = sorted(scores.items(), key=lambda x: x[1][0], reverse=True)[:max_candidates]
        result = []
        for phone_node, (weight, sources) in sorted_phones:
            raw_phone = self.graph.nodes[phone_node]['value']
            result.append((raw_phone, weight, {'sources': list(sources)}))
        return result

