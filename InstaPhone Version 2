# 6. CONFIDENCE SCORER (ML)
# ---------------------------------------------------------------------------
class ConfidenceScorer:
    """
    Gradient‑boosted model (XGBoost) that assigns a final confidence (0‑1)
    based on features like number of unique sources, name match distance,
    temporal freshness, geo‑coherence, etc.
    """
    def __init__(self, model_path: Optional[str] = None):
        self.model = None
        if XGB_AVAILABLE and model_path and Path(model_path).exists():
            with open(model_path, 'rb') as f:
                self.model = pickle.load(f)

    def score(self, phone: str, target_name: str, graph_weight: float, sources_count: int, name_similarity: float,
              geo_match: bool, days_since_leak: int) -> float:
        """Compute confidence. Falls back to heuristic if model absent."""
        features = {
            'graph_weight': graph_weight,
            'sources_count': sources_count,
            'name_similarity': name_similarity,
            'geo_match': int(geo_match),
            'days_since_leak': days_since_leak if days_since_leak else 3650,
        }
        if self.model:
            df = pd.DataFrame([features])
            # ensure columns order
            df = df[self.model.get_booster().feature_names]
            proba = self.model.predict_proba(df)[0, 1]
            return float(proba)
        else:
            # Heuristic
            score = min(1.0, (sources_count * 0.3) + (name_similarity * 0.4) + (0.1 * geo_match) + (graph_weight / 10 * 0.2))
            return score

