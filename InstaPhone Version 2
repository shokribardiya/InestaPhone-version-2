from pysqlcipher3 import dbapi2 as sqlcipher  # pip install pysqlcipher3

class BreachIndex:
    """
    Encrypted breach database with SQLCipher + optional Elasticsearch for full‑text search.
    Schema: (email, phone, name, username, source, leak_date, added_date)
    Supports bulk import from common breach formats.
    """
    def __init__(self, db_path: str, es_host: Optional[str] = None):
        self.db_path = db_path
        self.es_enabled = es_host is not None
        if self.es_enabled:
            from elasticsearch import Elasticsearch
            self.es = Elasticsearch([es_host])
        self._init_db()

    def _init_db(self):
        conn = sqlcipher.connect(self.db_path)
        conn.execute("PRAGMA key = 'instaphone_research';")  # Use a strong passphrase in production!
        conn.execute("""
            CREATE TABLE IF NOT EXISTS breaches (
                email TEXT,
                phone TEXT,
                name TEXT,
                username TEXT,
                source TEXT,
                leak_date TEXT,
                added_date TEXT DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(email, phone, name)
            )
        """)
        conn.commit()
        conn.close()

    def query_by_email(self, email: str) -> List[Tuple[str, str, str, str, str]]:
        conn = sqlcipher.connect(self.db_path)
        conn.execute("PRAGMA key = 'instaphone_research';")
        cur = conn.execute("SELECT phone, name, username, source, leak_date FROM breaches WHERE email=?", (email,))
        results = cur.fetchall()
        conn.close()
        return results

    def query_by_name(self, name: str) -> List[Tuple[str, str, str, str, str]]:
        conn = sqlcipher.connect(self.db_path)
        conn.execute("PRAGMA key = 'instaphone_research';")
        cur = conn.execute("SELECT phone, email, username, source, leak_date FROM breaches WHERE name LIKE ?", (f'%{name}%',))
        results = cur.fetchall()
        conn.close()
        return results

    def query_by_phone(self, phone: str) -> List[Tuple[str, str, str, str, str]]:
        conn = sqlcipher.connect(self.db_path)
        conn.execute("PRAGMA key = 'instaphone_research';")
        cur = conn.execute("SELECT email, name, username, source, leak_date FROM breaches WHERE phone=?", (phone,))
        results = cur.fetchall()
        conn.close()
        return results

    def bulk_insert(self, records: List[Tuple[str, str, str, str, str, str]]):
        conn = sqlcipher.connect(self.db_path)
        conn.execute("PRAGMA key = 'instaphone_research';")
        conn.executemany(
            "INSERT OR IGNORE INTO breaches (email, phone, name, username, source, leak_date) VALUES (?,?,?,?,?,?)",
            records
        )
        conn.commit()
        conn.close()
        if self.es_enabled:
            # Index in Elasticsearch asynchronously
