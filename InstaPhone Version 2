import icu  # PyICU for locale‑sensitive transliteration

class NameNormaliser:
    """
    Normalises names: transliteration (all scripts → Latin), lowercasing,
    removal of titles/suffixes, nickname generation via a pre‑trained
    Seq2Seq model (placeholder), and fuzzy matching.
    """
    def __init__(self, alias_dict: Optional[Dict[str, str]] = None):
        self.alias_dict = alias_dict or {}
        # Load a pretrained nickname model (demo: simple rule‑based)
        self.nickname_model = None  # In production: load a Transformer model

    def transliterate(self, text: str) -> str:
        """Convert any script to Latin using ICU."""
        transliterator = icu.Transliterator.createInstance('Any-Latin; NFD; [:Nonspacing Mark:] Remove; NFC')
        return transliterator.transliterate(text)

    def normalise_name(self, name: str) -> str:
        """Full pipeline: transliterate, lowercase, remove punctuation, strip titles."""
        name = self.transliterate(name)
        name = re.sub(r'[^\w\s]', '', name).lower().strip()
        # Remove common titles
        for title in ['mr', 'ms', 'mrs', 'dr', 'prof', 'phd']:
            name = re.sub(r'\b' + title + r'\b', '', name)
        return ' '.join(name.split())  # collapse spaces

    def segment_username(self, username: str) -> List[str]:
        """Split a username into probable name parts (e.g., john.doe → ['john','doe'])."""
        parts = re.split(r'[_\-.]+', username)
        # Expand known aliases
        if username.lower() in self.alias_dict:
            return self.alias_dict[username.lower()].split()
        return [p for p in parts if p]

    def generate_nicknames(self, name: str) -> List[str]:
        """
        Return common nicknames (e.g., 'Robert' → ['Bob', 'Rob', 'Bobby']).
        Uses a static mapping + ML model.
        """
        nick_map = {
            'robert': ['bob', 'rob', 'bobby'],
            'michael': ['mike', 'mickey'],
            'james': ['jim', 'jimmy'],
            # ... thousands more loaded from a JSON file
        }
        name_lower = name.lower()
        if name_lower in nick_map:
            return nick_map[name_lower]
        return []

