# 9. ORCHESTRATION ENGINE
# ---------------------------------------------------------------------------
class InstaPhoneEngine:
    def __init__(self):
        proxy_mgr = ProxyManager(config.IG_PROXY_LIST)
        self.scraper = InstagramScraper(proxy_mgr)
        self.resolver = CrossPlatformResolver(proxy_mgr)
        self.breach = BreachIndex(config.BREACH_DB_PATH, config.BREACH_ES_HOST)
        self.normaliser = NameNormaliser()
        self.scorer = ConfidenceScorer(config.MODEL_PATH)

    def search_by_username(self, username: str, top_n: int = 20) -> List[Tuple[str, float, Dict]]:
        profile = self.scraper.get_profile(username)
        if not profile:
            return []
        cross_data = {}
        if profile.get('website'):
            cross_data = self.resolver.resolve(profile['website'])
        # Gather breach data
        breach_emails = []
        all_emails = profile.get('emails_in_bio', []) + cross_data.get('emails', [])
        for email in all_emails:
            breach_emails.extend(self.breach.query_by_email(email))
        breach_names = []
        if profile.get('full_name'):
            norm_name = self.normaliser.normalise_name(profile['full_name'])
            breach_names = self.breach.query_by_name(norm_name)
        # Build graph
        graph = IdentityGraph()
        graph.build_from_profile(profile, cross_data, breach_emails, breach_names, [])
        target_id = f"identity_insta_{username}"
        candidates = graph.resolve_target(target_id, max_candidates=top_n*2)
        # Apply ML confidence
        final = []
        target_fullname = self.normaliser.normalise_name(profile.get('full_name', ''))
        for phone, graph_weight, meta in candidates:
            sources_count = len(meta.get('sources', []))
            # Compute name similarity between target name and names found in breach (simplified)
            name_sim = 1.0  # placeholder
            confidence = self.scorer.score(phone, target_fullname, graph_weight, sources_count, name_sim,
                                           geo_match=False, days_since_leak=365)
            final.append((phone, confidence, meta))
        final.sort(key=lambda x: x[1], reverse=True)
        return final[:top_n]

    def search_by_name(self, full_name: str, top_n: int = 20) -> List[Tuple[str, float, Dict]]:
        norm_name = self.normaliser.normalise_name(full_name)
        breach_rows = self.breach.query_by_name(norm_name)
        graph = IdentityGraph()
        target_id = f"identity_name_{norm_name}"
        for phone, email, username, src, ldate in breach_rows:
            graph.add_entity(target_id, 'phone', phone, 2.0, f'breach_{src}')
            if email:
                graph.add_entity(target_id, 'email', email, 1.5, f'breach_{src}')
        candidates = graph.resolve_target(target_id, max_candidates=top_n*2)
        final = []
        for phone, graph_weight, meta in candidates:
            confidence = self.scorer.score(phone, norm_name, graph_weight, len(meta.get('sources', [])), 1.0, False, 365)
            final.append((phone, confidence, meta))
        final.sort(key=lambda x: x[1], reverse=True)
        return final[:top_n]

